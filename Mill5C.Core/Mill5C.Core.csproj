<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Mill5C.Core</RootNamespace>
    <AssemblyName>Mill5C.Core</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <DocumentationFile>bin\Debug\Mill5C.Core.XML</DocumentationFile> <!-- Consider updating path or removing if not needed -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="log4net">
      <HintPath>..\Lib\log4net.dll</HintPath>
    </Reference>
    <!-- System.Threading might be part of .NET SDK now, or needs a NuGet package -->
    <!-- <Reference Include="System.Threading, Version=1.0.3058.34407, Culture=neutral, PublicKeyToken=31bf3856ad364e35, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\Lib\System.Threading.dll</HintPath>
      <Private>True</Private>
    </Reference> -->
    <!-- System.Management might require a NuGet package like System.Management -->
  </ItemGroup>

  <ItemGroup>
    <None Include="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>