    <RootNamespace>Mill5C.Settings</RootNamespace>
    <AssemblyName>Mill5C.Settings</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <UseWindowsForms>true</UseWindowsForms> <!-- Enable WinForms -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mill5C.Core\Mill5C.Core.csproj" />
  </ItemGroup>

  <!-- EmbeddedResources are usually picked up automatically by SDK-style projects
       if they are correctly placed (e.g., Page01.resx alongside Page01.cs).
       Designer.cs files are also handled automatically.
       The <Service> tag might be related to a specific designer or component and may need investigation
       if it's still relevant or how to migrate it.
  -->

</Project>