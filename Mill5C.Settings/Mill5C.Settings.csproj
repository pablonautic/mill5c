<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework> <!-- Objective 3 -->
    <UseWindowsForms>true</UseWindowsForms> <!-- Objective 4 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo> <!-- Objective 5 -->
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>

  <!-- Conditional properties from original project (Objective 10) -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <OutputPath>bin\x86\Debug\</OutputPath>
    <!-- Assuming Debug symbols & constants for Debug|x86 based on Debug|AnyCPU -->
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <OutputPath>bin\x86\Release\</OutputPath>
    <!-- Assuming Release optimize & constants for Release|x86 based on Release|AnyCPU -->
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project References (Objective 6) -->
    <ProjectReference Include="..\Mill5C.Core\Mill5C.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicitly include AssemblyInfo.cs because GenerateAssemblyInfo is false (Objective 5) -->
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- EmbeddedResource items (Objective 8) are typically handled automatically by the SDK
       if they follow standard naming conventions (e.g., Page01.cs and Page01.resx).
       No explicit <EmbeddedResource> tags are needed unless there's a non-standard setup. -->

</Project>
