<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType> <!-- Changed from Exe for WPF -->
    <TargetFramework>net6.0-windows</TargetFramework>
    <RootNamespace>Mill5C.View.Window</RootNamespace>
    <AssemblyName>MillingSimulator</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <UseWPF>true</UseWPF> <!-- Enable WPF -->
    <StartupObject>Mill5C.View.Window.App</StartupObject>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <!-- ProjectTypeGuids are not needed for SDK-style projects -->
    <!-- XNA references and content are removed as they are not directly compatible.
         This project will require significant work to restore XNA functionality,
         possibly by migrating to MonoGame or another graphics library. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Standard .NET SDK references are included automatically. -->
    <!-- System.ServiceModel might need a NuGet package like System.ServiceModel.Primitives -->
    <!-- 3DTools.dll, GraphicsDeviceControl.dll, InstancedModelSample.dll would need to be .NET compatible
         or replaced. For now, they are removed. -->
  </ItemGroup>

  <ItemGroup>
    <None Include="XnaNative.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="3DTools">
      <HintPath>..\Lib\3DTools.dll</HintPath>
    </Reference>
    <Reference Include="InstancedModelSample">
      <HintPath>Lib\InstancedModelSample.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.1.303" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.1.303" />
    <PackageReference Include="MonoGame.Forms.DX" Version="3.2.0" /> <!-- Check for latest version -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mill5C.Core\Mill5C.Core.csproj" />
    <ProjectReference Include="..\Mill5C.Settings\Mill5C.Settings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="App.ico" />
    <Resource Include="Resources\Abort.png" />
    <Resource Include="Resources\OK.png" />
    <Resource Include="Resources\Undo.png" />
    <Resource Include="Resources\Wrench.png" />
  </ItemGroup>

  <!--
  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>
  -->

  <!-- XAML files (ApplicationDefinition, Page) are typically included automatically.
       Compile Include items for .cs files are also automatic.
       EmbeddedResource for .resx files are also typically automatic.
       Content items (XNB files) and XnaNative.dll are removed due to incompatibility.
  -->

</Project>