<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework> <!-- Objective 3 -->
    <UseWPF>true</UseWPF> <!-- Objective 4 -->
    <!-- OutputType>WinExe</OutputType> is implied by UseWPF=true -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo> <!-- Objective 5 -->
    <StartupObject>Mill5C.View.Window.App</StartupObject> <!-- Objective 13 -->
    <AssemblyName>MillingSimulator</AssemblyName> <!-- Objective 14 -->
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>

  <!-- Conditional properties from original project (Objective 12) -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols> <!-- Added for consistency -->
    <DebugType>full</DebugType> <!-- Added for consistency -->
    <Optimize>false</Optimize> <!-- Added for consistency -->
    <DefineConstants>DEBUG;TRACE</DefineConstants> <!-- Added for consistency -->
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <OutputPath>bin\x86\Release\</OutputPath>
    <Optimize>true</Optimize> <!-- Added for consistency -->
    <DebugType>pdbonly</DebugType> <!-- Added for consistency -->
    <DefineConstants>TRACE</DefineConstants> <!-- Added for consistency -->
  </PropertyGroup>

  <ItemGroup>
    <!-- DLL References (Objective 7) -->
    <Reference Include="3DTools">
      <HintPath>..\Lib\3DTools.dll</HintPath>
    </Reference>
    <Reference Include="GraphicsDeviceControl">
      <HintPath>Lib\GraphicsDeviceControl.dll</HintPath> <!-- Path relative to this project -->
    </Reference>
    <Reference Include="InstancedModelSample">
      <HintPath>Lib\InstancedModelSample.dll</HintPath> <!-- Path relative to this project -->
    </Reference>
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>..\Lib\Microsoft.Xna.Framework.dll</HintPath>
      <Private>True</Private> <!-- Preserving Private state if it was True -->
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Content.Pipeline">
      <HintPath>..\Lib\Microsoft.Xna.Framework.Content.Pipeline.dll</HintPath>
      <Private>True</Private> <!-- Preserving Private state if it was True -->
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Content.Pipeline.EffectImporter">
      <HintPath>..\Lib\Microsoft.Xna.Framework.Content.Pipeline.EffectImporter.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Content.Pipeline.FBXImporter">
      <HintPath>..\Lib\Microsoft.Xna.Framework.Content.Pipeline.FBXImporter.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Content.Pipeline.TextureImporter">
      <HintPath>..\Lib\Microsoft.Xna.Framework.Content.Pipeline.TextureImporter.dll</HintPath>
    </Reference>
    <!-- System references like System.Drawing, System.Windows.Forms, PresentationFramework.Luna, System.ServiceModel are typically handled by SDK + UseWPF -->
  </ItemGroup>

  <ItemGroup>
    <!-- Project References (Objective 6) -->
    <ProjectReference Include="..\Mill5C.Core\Mill5C.Core.csproj" />
    <ProjectReference Include="..\Mill5C.Settings\Mill5C.Settings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicitly include AssemblyInfo.cs because GenerateAssemblyInfo is false (Objective 5) -->
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content Files (Objective 9) -->
    <Content Include="Content\*.xnb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- XnaNative.dll (Objective 7) -->
    <None Include="XnaNative.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- App.config was present -->
    <None Include="app.config" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resource Files (Objective 10) -->
    <Resource Include="App.ico" />
    <Resource Include="Resources\*.png" />
  </ItemGroup>

  <!-- XAML files (App.xaml, MainWindow.xaml, Views/WPF/DrawingControl.xaml) are handled by SDK (Objective 8) -->
  <!-- Embedded resources like .resx files are handled by SDK (Objective 10) -->

</Project>
