<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework> <!-- Objective 3 -->
    <!-- OutputType>Exe</OutputType> is default for console apps (Objective 4) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo> <!-- Objective 5 -->
    <Configurations>Debug;Release</Configurations>
    <Platforms>AnyCPU;x86</Platforms>
    <!-- AssemblyName was MillingSimulator.Console, if this needs to be preserved: -->
    <AssemblyName>MillingSimulator.Console</AssemblyName>
  </PropertyGroup>

  <!-- Conditional properties from original project (Objective 9) -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>bin\x86\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicitly kept references (Objective 7) -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project References (Objective 6) -->
    <ProjectReference Include="..\Mill5C.Core\Mill5C.Core.csproj" />
    <ProjectReference Include="..\Mill5C.Settings\Mill5C.Settings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicitly include AssemblyInfo.cs because GenerateAssemblyInfo is false (Objective 5) -->
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>
